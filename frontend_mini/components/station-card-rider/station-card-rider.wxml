<!-- 骑手站点卡片组件 -->
<view class="station-card" bindtap="onNavigate">
  <!-- 站点名称 -->
  <view class="station-card__header">
    <text class="station-card__name">{{station.name}}</text>
  </view>

  <!-- 距离显示 -->
  <view class="station-card__distance">
    <text class="station-card__distance-number">{{station.distance}}</text>
    <text class="station-card__distance-unit">km</text>
  </view>

  <!-- 电池状态 -->
  <view class="station-card__battery">
    <view class="station-card__status-dot status-{{batteryStatus}}"></view>
    <text class="station-card__battery-text">可用电池：</text>
    <text class="station-card__battery-count">{{station.available_batteries}}</text>
  </view>

  <!-- 导航按钮 -->
  <view class="station-card__action">
    <button class="station-card__nav-btn" catchtap="onNavigate">
      <text>导航前往</text>
    </button>
  </view>
</view>
