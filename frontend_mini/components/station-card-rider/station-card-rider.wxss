/* 骑手站点卡片组件样式 */
.station-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 184, 166, 0.12);
  border: 1rpx solid rgba(20, 184, 166, 0.12);
  transition: all 200ms ease;
}

.station-card:active {
  background: #F0FDFA;
  transform: translateY(-2rpx);
}

.station-card__header {
  margin-bottom: 24rpx;
}

.station-card__name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.5rpx;
}

.station-card__distance {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.station-card__distance-number {
  font-family: 'DIN Alternate', 'SF Mono', monospace;
  font-size: 80rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
  letter-spacing: -2rpx;
}

.station-card__distance-unit {
  font-size: 32rpx;
  font-weight: 700;
  color: #64748B;
  margin-left: 8rpx;
}

.station-card__battery {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.station-card__status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.station-card__status-dot.status-available {
  background: var(--success);
  box-shadow: 0 0 14rpx rgba(34, 197, 94, 0.42);
  animation: pulse 2s ease-in-out infinite;
}

.station-card__status-dot.status-low {
  background: var(--warning);
  box-shadow: 0 0 14rpx rgba(250, 204, 21, 0.42);
  animation: blink 1s ease-in-out infinite;
}

.station-card__status-dot.status-empty {
  background: var(--danger);
  box-shadow: 0 0 14rpx rgba(239, 68, 68, 0.42);
}

.station-card__battery-text {
  font-size: 28rpx;
  color: #64748B;
  margin-right: 8rpx;
}

.station-card__battery-count {
  font-family: 'DIN Alternate', 'SF Mono', monospace;
  font-size: 36rpx;
  font-weight: 800;
  color: #0F172A;
}

.station-card__action {
  margin-top: 8rpx;
}

.station-card__nav-btn {
  width: 100%;
  height: 96rpx;
  background: var(--brand-gradient);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(20, 184, 166, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms ease;
}

.station-card__nav-btn::after {
  border: none;
}

.station-card__nav-btn:active {
  transform: scale(0.98);
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.12); }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}


