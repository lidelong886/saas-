.mode-switcher {
  padding: 18rpx 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #F0FDFA 100%);
  border-bottom: 1rpx solid rgba(20, 184, 166, 0.12);
}

.switcher-container {
  display: flex;
  background: rgba(20, 184, 166, 0.08);
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
}

.mode-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  background: transparent;
  transition: all 200ms ease;
  min-height: 88rpx;
}

.mode-item:active {
  opacity: 0.85;
}

.mode-item.active {
  background: var(--brand-gradient);
  box-shadow: 0 10rpx 24rpx rgba(20, 184, 166, 0.22);
}

.mode-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  transition: all 200ms ease;
}

.mode-item.active .mode-icon {
  transform: scale(1.1);
}

.mode-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 700;
  transition: all 200ms ease;
}

.mode-item.active .mode-label {
  color: #fff;
  font-weight: 800;
}


