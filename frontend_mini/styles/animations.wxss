/* ═══════════════════════════════════════════════════════════
   PowerNest 骑手模式 · 动画效果库
   ═══════════════════════════════════════════════════════════ */

/* ── 卡片进入动画 ──────────────────────────────────────── */
@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-in-up {
  animation: slideInUp 300ms ease-out;
}

/* ── 指示灯呼吸动画 ────────────────────────────────────── */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.1);
  }
}

.pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* ── 指示灯闪烁动画（警告状态） ────────────────────────── */
@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

.blink {
  animation: blink 1s ease-in-out infinite;
}

/* ── 数字跳动动画 ──────────────────────────────────────── */
@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.bounce {
  animation: bounce 600ms ease-in-out;
}

/* ── 按钮点击反馈 ──────────────────────────────────────── */
@keyframes tap-feedback {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.95);
  }
  100% {
    transform: scale(1);
  }
}

.tap-feedback:active {
  animation: tap-feedback 200ms ease-out;
}

/* ── 发光脉冲动画 ──────────────────────────────────────── */
@keyframes glow-pulse {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(0, 255, 136, 0.3);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(0, 255, 136, 0.6);
  }
}

.glow-pulse {
  animation: glow-pulse 2s ease-in-out infinite;
}

/* ── 淡入动画 ──────────────────────────────────────────── */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 300ms ease-out;
}

/* ── 旋转动画（加载状态） ──────────────────────────────── */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.spin {
  animation: spin 1s linear infinite;
}

/* ── 震动动画（错误提示） ──────────────────────────────── */
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}

.shake {
  animation: shake 400ms ease-in-out;
}

/* ── 缩放进入动画 ──────────────────────────────────────── */
@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.scale-in {
  animation: scaleIn 300ms ease-out;
}

/* ── 延迟动画类 ────────────────────────────────────────── */
.delay-100 {
  animation-delay: 100ms;
}

.delay-200 {
  animation-delay: 200ms;
}

.delay-300 {
  animation-delay: 300ms;
}

.delay-400 {
  animation-delay: 400ms;
}


