/* ═══════════════════════════════════════════════════════════
   PowerNest 骑手模式 · 设计系统
   配色：荧光绿 var(--success) + 深色背景 #1a1a1a
   ═══════════════════════════════════════════════════════════ */

/* ── 颜色系统 ──────────────────────────────────────────── */
:root {
  /* 主色调 */
  --color-primary: var(--success);
  --color-primary-dark: #16A34A;
  --color-primary-light: #33ffaa;
  --color-warning: var(--warning);
  --color-danger: var(--danger);
  --color-success: var(--success);

  /* 背景色 */
  --bg-dark: #1a1a1a;
  --bg-card: #2a2a2a;
  --bg-card-hover: #333333;
  --bg-overlay: rgba(0, 0, 0, 0.8);

  /* 文字色 */
  --text-primary: #ffffff;
  --text-secondary: #999999;
  --text-tertiary: #666666;

  /* 状态色 */
  --status-available: var(--success);
  --status-low: var(--warning);
  --status-empty: var(--danger);

  /* 字体系统 */
  --font-number: 'Rajdhani', 'DIN Alternate', 'SF Mono', monospace;
  --font-body: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;

  /* 字号 */
  --text-xs: 24rpx;
  --text-sm: 28rpx;
  --text-base: 32rpx;
  --text-lg: 36rpx;
  --text-xl: 40rpx;
  --text-2xl: 48rpx;
  --text-3xl: 64rpx;
  --text-4xl: 80rpx;

  /* 间距系统 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
  --shadow-glow: 0 0 20rpx rgba(0, 255, 136, 0.3);
}

/* ── 骑手模式全局样式 ──────────────────────────────────── */
.delivery-mode {
  background: var(--bg-dark);
  color: var(--text-primary);
  min-height: 100vh;
}

.delivery-mode page {
  background: var(--bg-dark);
  color: var(--text-primary);
}

/* ── 按钮样式 ──────────────────────────────────────────── */
.delivery-mode .button-primary {
  background: var(--color-primary);
  color: #000000;
  font-weight: 700;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-glow);
  transition: all 200ms ease;
}

.delivery-mode .button-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
}

.delivery-mode .button-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  font-weight: 600;
  border-radius: var(--radius-md);
  transition: all 200ms ease;
}

.delivery-mode .button-secondary:active {
  background: rgba(0, 255, 136, 0.1);
}

.delivery-mode .button-danger {
  background: var(--color-danger);
  color: var(--text-primary);
  font-weight: 700;
  border-radius: var(--radius-md);
  box-shadow: 0 0 20rpx rgba(255, 59, 48, 0.3);
}

/* ── 卡片样式 ──────────────────────────────────────────── */
.delivery-mode .card-dark {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  transition: all 200ms ease;
}

.delivery-mode .card-dark:active {
  background: var(--bg-card-hover);
  transform: translateY(-2rpx);
}

/* ── 数字样式 ──────────────────────────────────────────── */
.number-display {
  font-family: var(--font-number);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

/* ── 状态指示器 ────────────────────────────────────────── */
.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 6rpx 16rpx;
  border-radius: 50rpx;
  font-size: var(--text-xs);
  font-weight: 600;
}

.status-indicator-available {
  background: rgba(0, 255, 136, 0.15);
  color: var(--status-available);
}

.status-indicator-low {
  background: rgba(255, 107, 53, 0.15);
  color: var(--status-low);
}

.status-indicator-empty {
  background: rgba(255, 59, 48, 0.15);
  color: var(--status-empty);
}

/* ── 发光效果 ──────────────────────────────────────────── */
.glow-primary {
  box-shadow: 0 0 20rpx rgba(0, 255, 136, 0.4);
}

.glow-warning {
  box-shadow: 0 0 20rpx rgba(255, 107, 53, 0.4);
}

.glow-danger {
  box-shadow: 0 0 20rpx rgba(255, 59, 48, 0.4);
}


