/* pages/store/list.wxss */
page {
  background: #08111f;
}

.store-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    radial-gradient(circle at 15% 0%, rgba(45, 212, 191, 0.26), transparent 34%),
    radial-gradient(circle at 92% 12%, rgba(99, 102, 241, 0.26), transparent 30%),
    linear-gradient(180deg, #0f172a 0%, #eef8f7 42%, #f8fafc 100%);
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx 30rpx;
  border-radius: 36rpx;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.98), rgba(17, 94, 89, 0.9)),
    repeating-linear-gradient(45deg, rgba(255,255,255,0.06) 0 2rpx, transparent 2rpx 18rpx);
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.34);
}

.hero-glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(2rpx);
  opacity: 0.7;
}

.hero-glow-a {
  width: 210rpx;
  height: 210rpx;
  right: -70rpx;
  top: -70rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-glow-b {
  width: 140rpx;
  height: 140rpx;
  left: 42rpx;
  bottom: -78rpx;
  background: rgba(45, 212, 191, 0.32);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-showpiece {
  position: relative;
  width: 188rpx;
  height: 210rpx;
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orbit-ring {
  position: absolute;
  border-radius: 999rpx;
  border: 2rpx solid rgba(204, 251, 241, 0.26);
  transform: rotate(-18deg);
}

.ring-a {
  width: 168rpx;
  height: 104rpx;
}

.ring-b {
  width: 134rpx;
  height: 188rpx;
  border-color: rgba(255, 255, 255, 0.18);
  transform: rotate(24deg);
}

.premium-cell {
  position: relative;
  width: 82rpx;
  height: 154rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #f8fafc 0%, #99f6e4 46%, #0f766e 100%);
  box-shadow: 0 20rpx 46rpx rgba(45, 212, 191, 0.34), inset 0 0 0 3rpx rgba(255,255,255,0.62);
}

.premium-cell text {
  position: absolute;
  left: 0;
  right: 0;
  top: 56rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
  color: #0f172a;
}

.cell-shine {
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 18rpx;
  height: 116rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.48);
}

.cell-core {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.2);
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.66);
  text-transform: uppercase;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  margin-top: 18rpx;
  max-width: 520rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.78);
}

.hero-badge {
  position: absolute;
  right: 0;
  top: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #083344;
  background: linear-gradient(135deg, #ccfbf1, #ffffff);
}

.trust-rail {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 28rpx;
}

.trust-rail text {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.12);
}

.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 34rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(18rpx);
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-stat-value {
  font-size: 32rpx;
  font-weight: 900;
}

.hero-stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

.search-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.12);
}

.search-box {
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
}

.search-icon {
  font-size: 36rpx;
  color: #64748b;
  margin-right: 12rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #64748b;
  background: #e2e8f0;
  font-size: 34rpx;
}

.filter-title {
  margin-top: 22rpx;
  font-size: 23rpx;
  font-weight: 900;
  color: #0f172a;
}

.price-title {
  margin-top: 18rpx;
}

.tab-row,
.sort-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 14rpx;
}

.price-row {
  flex-wrap: wrap;
}

.chip,
.price-chip,
.sort-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.chip.active,
.price-chip.active,
.sort-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #14b8a6, #0f766e);
  border-color: transparent;
  box-shadow: 0 12rpx 26rpx rgba(20, 184, 166, 0.22);
}

.sort-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #94a3b8;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 8rpx 18rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #64748b;
}

.section-link {
  font-size: 24rpx;
  font-weight: 800;
  color: #14b8a6;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(255,255,255,1)),
    radial-gradient(circle at 0% 0%, rgba(20,184,166,0.13), transparent 32%);
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.1);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}

.featured-ribbon {
  position: absolute;
  right: -48rpx;
  top: 26rpx;
  z-index: 3;
  width: 190rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  transform: rotate(38deg);
  color: #083344;
  font-size: 20rpx;
  font-weight: 900;
  background: linear-gradient(90deg, #fef3c7, #ccfbf1);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.12);
}

.product-card.featured {
  border: 2rpx solid rgba(20, 184, 166, 0.42);
}

.product-main {
  display: flex;
  padding: 28rpx 28rpx 18rpx;
}

.product-visual {
  width: 170rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.battery-shell {
  position: relative;
  width: 92rpx;
  height: 178rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  border: 6rpx solid #0f172a;
  background: linear-gradient(180deg, #fff, #e2e8f0);
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.7);
}

.battery-cap {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 14rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #0f172a;
}

.battery-fill {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  min-height: 10rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #5eead4 0%, #14b8a6 48%, #0f766e 100%);
}

.battery-percent {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
  color: #0f172a;
}

.visual-shadow {
  width: 118rpx;
  height: 20rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(15,23,42,0.24), transparent 70%);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
  color: #64748b;
  background: #f1f5f9;
}

.tag.primary {
  color: #0f766e;
  background: #ccfbf1;
}

.product-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  color: #0f172a;
}

.product-code {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #94a3b8;
}

.spec-grid {
  display: flex;
  margin-top: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  overflow: hidden;
}

.spec-item {
  flex: 1;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spec-value {
  font-size: 24rpx;
  font-weight: 900;
  color: #0f172a;
}

.spec-label {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #94a3b8;
}

.service-strip {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 18rpx 28rpx;
  font-size: 22rpx;
  color: #0f766e;
  background: linear-gradient(90deg, #ecfdf5, #f8fafc);
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 30rpx;
}

.price-block {
  display: flex;
  flex-direction: column;
}

.price-label,
.deposit {
  font-size: 21rpx;
  color: #94a3b8;
}

.currency {
  font-size: 26rpx;
  font-weight: 900;
  color: #ef4444;
}

.price {
  font-size: 46rpx;
  line-height: 1;
  font-weight: 900;
  color: #ef4444;
  letter-spacing: -1rpx;
}

.deposit {
  margin-top: 6rpx;
}

.buy-btn {
  margin: 0;
  min-width: 188rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #0f172a 0%, #14b8a6 100%);
  box-shadow: 0 14rpx 30rpx rgba(20, 184, 166, 0.28);
}

.buy-btn::after,
.empty-btn::after {
  border: none;
}

.empty-state {
  margin-top: 44rpx;
  padding: 70rpx 44rpx;
  border-radius: 34rpx;
  background: rgba(255,255,255,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-orb {
  width: 138rpx;
  height: 138rpx;
  line-height: 138rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  font-size: 70rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #0f172a;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #64748b;
}

.empty-btn {
  margin-top: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 800;
  background: #ccfbf1;
}

.load-footer {
  padding: 34rpx 0 8rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}
