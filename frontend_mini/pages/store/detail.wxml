<!--pages/store/detail.wxml-->
<view class="detail-page" wx:if="{{battery}}">
  <view class="detail-hero">
    <view class="hero-label">PowerNest Certified</view>
    <view class="product-visual">
      <view class="battery-shell">
        <view class="battery-fill" style="height: {{battery.powerLevel}}%;"></view>
        <text class="battery-percent">{{battery.powerLevel}}%</text>
      </view>
    </view>
    <view class="product-title">{{battery.modelName || battery.model}}</view>
    <view class="product-code">按规格售卖，支付后自动分配同类电池</view>
  </view>

  <view class="info-card price-card">
    <view>
      <text class="muted">官方到手价</text>
      <view><text class="currency">¥</text><text class="price">{{battery.displayPrice}}</text></view>
    </view>
    <view class="stock-badge">库存 {{battery.stock}} 件</view>
  </view>

  <view class="info-card">
    <view class="card-title">核心参数</view>
    <view class="spec-grid">
      <view class="spec-item">
        <text class="spec-value">{{battery.voltageType}}</text>
        <text class="spec-label">电压规格</text>
      </view>
      <view class="spec-item">
        <text class="spec-value">{{battery.capacityDisplay}}</text>
        <text class="spec-label">额定容量</text>
      </view>
      <view class="spec-item">
        <text class="spec-value">{{battery.avgPowerLevel || battery.powerLevel}}%</text>
        <text class="spec-label">平均电量</text>
      </view>
      <view class="spec-item">
        <text class="spec-value">¥{{battery.depositDisplay}}</text>
        <text class="spec-label">押金参考</text>
      </view>
    </view>
  </view>

  <view class="info-card">
    <view class="card-title">服务承诺</view>
    <view class="service-line"><text>✓</text><text>官方认证电池，购买后自动从该规格库存分配实物电池</text></view>
    <view class="service-line"><text>✓</text><text>24个月质保，同城站点售后响应</text></view>
    <view class="service-line"><text>✓</text><text>购买后可在公共充电桩给专属电池低价充电</text></view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-price"><text>¥</text>{{battery.displayPrice}}</view>
    <button class="buy-btn" bindtap="buyNow">立即购买</button>
  </view>
</view>
