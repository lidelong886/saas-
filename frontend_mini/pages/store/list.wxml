<!--pages/store/list.wxml-->
<view class="store-page">
  <view class="hero-card">
    <view class="hero-glow hero-glow-a"></view>
    <view class="hero-glow hero-glow-b"></view>
    <view class="hero-top">
      <view>
        <view class="eyebrow">PowerNest Official Store</view>
        <view class="hero-title">电池品类商城</view>
        <view class="hero-subtitle">按规格购买 · 自动分配同类电池 · 支持公共充电桩充电</view>
      </view>
      <view class="hero-badge">直营</view>
    </view>
    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-stat-value">24月</text>
        <text class="hero-stat-label">质保服务</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-value">100%</text>
        <text class="hero-stat-label">官方验真</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-value">同城</text>
        <text class="hero-stat-label">售后响应</text>
      </view>
    </view>
  </view>

  <view class="search-panel">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{keyword}}" placeholder="搜索 60V、72V、24Ah、36Ah" bindinput="onSearchInput" confirm-type="search" />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">×</text>
    </view>
    <view class="filter-title">按电压分类</view>
    <view class="tab-row">
      <view class="chip {{activeVoltage === item.key ? 'active' : ''}}" wx:for="{{voltageTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchVoltage">{{item.label}}</view>
    </view>
    <view class="filter-title price-title">按价格分类</view>
    <view class="tab-row price-row">
      <view class="chip price-chip {{activePrice === item.key ? 'active' : ''}}" wx:for="{{priceTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchPrice">{{item.label}}</view>
    </view>
    <view class="sort-row">
      <text class="sort-label">排序</text>
      <view class="sort-chip {{sortMode === item.key ? 'active' : ''}}" wx:for="{{sortTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchSort">{{item.label}}</view>
    </view>
  </view>

  <view class="section-head">
    <view>
      <text class="section-title">规格品类</text>
      <text class="section-subtitle">{{filteredBatteries.length}} 类可购买电池</text>
    </view>
    <text class="section-link">正品保障</text>
  </view>

  <view class="product-list" wx:if="{{filteredBatteries.length > 0}}">
    <view class="product-card {{item.isFeatured ? 'featured' : ''}}" wx:for="{{filteredBatteries}}" wx:key="id">
      <view class="featured-ribbon" wx:if="{{item.isFeatured}}">旗舰推荐</view>
      <view class="product-main" bindtap="onBatteryTap" data-battery="{{item}}">
        <view class="product-visual">
          <view class="battery-shell">
            <view class="battery-cap"></view>
            <view class="battery-fill" style="height: {{item.powerLevel}}%;"></view>
            <text class="battery-percent">{{item.powerLevel}}%</text>
          </view>
          <view class="visual-shadow"></view>
        </view>
        <view class="product-info">
          <view class="product-tags">
            <text class="tag primary">{{item.voltageType}}</text>
            <text class="tag">{{item.sellingPoint}}</text>
          </view>
          <view class="product-name">{{item.modelName}}</view>
          <view class="product-code">系统将从该规格库存中自动分配电池</view>
          <view class="spec-grid">
            <view class="spec-item">
              <text class="spec-value">{{item.capacityDisplay}}</text>
              <text class="spec-label">额定容量</text>
            </view>
            <view class="spec-item">
              <text class="spec-value">{{item.stock}} 件</text>
              <text class="spec-label">可售库存</text>
            </view>
            <view class="spec-item">
              <text class="spec-value">{{item.warrantyText}}</text>
              <text class="spec-label">官方保障</text>
            </view>
          </view>
        </view>
      </view>
      <view class="service-strip">
        <text>✓ 原厂检测</text>
        <text>✓ {{item.serviceText}}</text>
        <text>✓ 购买后绑定到我的专属电池</text>
      </view>
      <view class="product-footer">
        <view class="price-block">
          <text class="price-label">到手价</text>
          <view><text class="currency">¥</text><text class="price">{{item.displayPrice}}</text></view>
          <text class="deposit">押金参考 ¥{{item.depositDisplay}}</text>
        </view>
        <button class="buy-btn" data-battery="{{item}}" bindtap="onPurchaseTap">立即购买</button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-orb">🔋</view>
    <text class="empty-title">暂无匹配商品</text>
    <text class="empty-desc">换个筛选条件，或下拉刷新查看最新上架电池</text>
    <button class="empty-btn" bindtap="clearSearch">重置筛选</button>
  </view>

  <view class="load-footer" wx:if="{{batteries.length > 0}}">
    <text wx:if="{{isLoading}}">正在加载更多好物...</text>
    <text wx:elif="{{!hasMore}}">已展示全部官方现货</text>
  </view>
</view>
