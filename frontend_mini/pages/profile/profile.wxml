<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 极简用户资产卡片 -->
  <view class="user-card">
    <view class="user-info" bindtap="{{hasLogin ? 'onLogout' : 'onLoginTap'}}">
      <view class="avatar">
        <text class="avatar-text">{{avatarPlaceholderText}}</text>
      </view>
      <view class="info-content">
        <text class="username">{{hasLogin ? userInfo.username : '点击登录/注册'}}</text>
        <text class="phone" wx:if="{{hasLogin && userInfo.phone}}">{{userInfo.phone}}</text>
        <text class="login-tip" wx:elif="{{!hasLogin}}">登录后享受便捷换电</text>
      </view>
      <text class="logout-btn" wx:if="{{hasLogin}}" catchtap="onLogout">退出登录</text>
    </view>

    <view class="operator-row" bindtap="goToTenantSwitch">
      <view>
        <text class="operator-label">当前运营商</text>
        <text class="operator-name">{{tenantName}}</text>
      </view>
      <text class="operator-action">切换 ></text>
    </view>
    
    <!-- 核心数据看板 -->
    <view class="dashboard" wx:if="{{hasLogin}}">
      <view class="dash-item" bindtap="goToBalance">
        <text class="dash-value">¥ {{balance}}</text>
        <text class="dash-label">我的余额</text>
      </view>
      <view class="dash-divider"></view>
      <view class="dash-item" bindtap="onMenuItemTap" data-item="{{menuItems[4]}}">
        <text class="dash-value">{{stats.rentedBattery ? '1' : '0'}} 块</text>
        <text class="dash-label">在租电池</text>
      </view>
      <view class="dash-divider"></view>
      <view class="dash-item" bindtap="onMenuItemTap" data-item="{{menuItems[3]}}">
        <text class="dash-value">{{stats.currentPackage ? '有' : '无'}}</text>
        <text class="dash-label">当前套餐</text>
      </view>
    </view>
  </view>

  <!-- 骑手刚需功能区 -->
  <view class="menu-section">
    <view class="menu-header">
      <text class="menu-title">我的服务</text>
    </view>
    <view class="menu-grid">
      <view class="grid-item" bindtap="goToNotifications">
        <view class="grid-icon-wrap">
          <text class="grid-icon">通知</text>
          <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <text class="grid-text">消息通知</text>
      </view>
      <view class="grid-item" bindtap="goToFaultList">
        <text class="grid-icon">报修</text>
        <text class="grid-text">我的报修</text>
      </view>
      <view class="grid-item" bindtap="goToStore">
        <text class="grid-icon">商店</text>
        <text class="grid-text">电池商店</text>
      </view>
      <view class="grid-item" bindtap="onMenuItemTap" data-item="{{menuItems[1]}}">
        <text class="grid-icon">订单</text>
        <text class="grid-text">我的订单</text>
      </view>
      <view class="grid-item" bindtap="onMenuItemTap" data-item="{{menuItems[2]}}">
        <text class="grid-icon">换电</text>
        <text class="grid-text">换电记录</text>
      </view>
      <view class="grid-item" bindtap="onMenuItemTap" data-item="{{menuItems[3]}}">
        <text class="grid-icon">卡券</text>
        <text class="grid-text">我的卡券</text>
      </view>
      <view class="grid-item" bindtap="onMenuItemTap" data-item="{{menuItems[4]}}">
        <text class="grid-icon">电池</text>
        <text class="grid-text">我的电池</text>
      </view>
    </view>
  </view>

  
<!-- 其他设置 -->
  <view class="list-section">
    <view class="list-item" bindtap="goToTenant">
      <view class="list-left">
        <text class="list-icon">入驻</text>
        <text class="list-text">运营商入驻申请</text>
      </view>
      <text class="list-arrow">></text>
    </view>
    <view class="list-item" bindtap="onMenuItemTap" data-item="{{menuItems[5]}}">
      <view class="list-left">
        <text class="list-icon">认证</text>
        <text class="list-text">实名认证</text>
      </view>
      <text class="list-arrow">></text>
    </view>
    <view class="list-item" bindtap="onMenuItemTap" data-item="{{menuItems[7]}}">
      <view class="list-left">
        <text class="list-icon">客服</text>
        <text class="list-text">联系客服 (400-123-4567)</text>
      </view>
      <text class="list-arrow">></text>
    </view>
    <view class="list-item" bindtap="onMenuItemTap" data-item="{{menuItems[8]}}">
      <view class="list-left">
        <text class="list-icon">帮助</text>
        <text class="list-text">帮助中心</text>
      </view>
      <text class="list-arrow">></text>
    </view>
    <view class="list-item" bindtap="onMenuItemTap" data-item="{{menuItems[6]}}">
      <view class="list-left">
        <text class="list-icon">设置</text>
        <text class="list-text">设置</text>
      </view>
      <text class="list-arrow">></text>
    </view>
  </view>

  <!-- 底部环境提示 -->
  <view class="env-info">
    <text class="env-text" bindtap="onApiHelpTap">{{apiBaseShort}}</text>
    <text class="env-text">PowerNest v1.0.0</text>
    <text class="env-text" wx:if="{{tenantInfo && tenantInfo.brand_name}}">{{tenantInfo.brand_name}}</text>
  </view>
</view>
