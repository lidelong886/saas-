.container {
  min-height: 100vh;
  background: #F0FDFA;
  padding-bottom: 48rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.user-card {
  margin: 0 0 30rpx;
  padding: 64rpx 40rpx 56rpx;
  color: #ffffff;
  background: var(--brand-gradient);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, 0.24);
  position: relative;
  overflow: hidden;
}

.user-card::before,
.user-card::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.user-card::before {
  width: 300rpx;
  height: 300rpx;
  top: -130rpx;
  right: -90rpx;
  background: rgba(255, 255, 255, 0.18);
}

.user-card::after {
  width: 220rpx;
  height: 220rpx;
  bottom: -100rpx;
  left: -70rpx;
  background: rgba(255, 255, 255, 0.14);
}

.user-info {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  position: relative;
  z-index: 1;
}

.user-info:active {
  opacity: 0.92;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 4rpx solid rgba(255, 255, 255, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(15, 118, 110, 0.22);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.username {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
  color: #ffffff;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone,
.login-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.logout-btn {
  min-width: 144rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--primary-dark);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 10rpx 22rpx rgba(15, 118, 110, 0.18);
  flex-shrink: 0;
}

.logout-btn:active {
  transform: scale(0.96);
  background: #ffffff;
}

.operator-row {
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.operator-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  font-weight: 700;
  margin-bottom: 4rpx;
}

.operator-name {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 900;
  line-height: 1.25;
}

.operator-action {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.dashboard {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 44rpx;
  padding: 28rpx 0;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 28rpx;
  position: relative;
  z-index: 1;
}

.dash-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
}

.dash-item:active {
  opacity: 0.84;
}

.dash-value {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  color: #ffffff;
}

.dash-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.dash-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.24);
}

.menu-section,
.list-section {
  margin: 0 30rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 184, 166, 0.10);
  border: 1rpx solid rgba(20, 184, 166, 0.08);
}

.menu-section {
  padding: 30rpx 24rpx 12rpx;
}

.menu-header {
  margin-bottom: 24rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  position: relative;
  padding-left: 18rpx;
}

.menu-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: var(--primary);
  border-radius: 8rpx;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  min-height: 126rpx;
}

.grid-item:active {
  transform: scale(0.96);
  opacity: 0.86;
}

.grid-icon-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.grid-icon {
  min-width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 10rpx;
  border-radius: 22rpx;
  display: inline-block;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--primary-dark);
  background: #F0FDFA;
  border: 1rpx solid rgba(20, 184, 166, 0.16);
  box-sizing: border-box;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  background: linear-gradient(135deg, #FF6B6B, #EF4444);
  color: white;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  min-width: 28rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(239, 68, 68, 0.25);
}

.grid-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

.list-section {
  padding: 0 30rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  min-height: 88rpx;
}

.list-item:active {
  opacity: 0.82;
}

.list-item:last-child {
  border-bottom: none;
}

.list-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.list-icon {
  min-width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 18rpx;
  margin-right: 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--primary-dark);
  background: #F0FDFA;
  border: 1rpx solid rgba(20, 184, 166, 0.14);
}

.list-text {
  font-size: 29rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-arrow {
  color: #CBD5E1;
  font-family: monospace;
  font-size: 34rpx;
  margin-left: 16rpx;
}

.env-info {
  text-align: center;
  padding: 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.env-text {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}
