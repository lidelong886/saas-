<!--pages/profile/bind-phone.wxml-->
<view class="container">
  <view class="header">
    <text class="title">绑定手机号</text>
    <text class="subtitle">用于账号安全验证</text>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" bindinput="onPhoneInput" />
    </view>
    <view class="form-item code-item">
      <view class="code-input-wrap">
        <text class="label">验证码</text>
        <input class="input" type="number" maxlength="6" placeholder="请输入验证码" bindinput="onCodeInput" />
      </view>
      <button class="code-btn" bindtap="onSendCode" disabled="{{!canSendCode}}">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit">确认绑定</button>
</view>
