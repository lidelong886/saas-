<view class="container">
  <view class="hero-glow hero-glow-a"></view>
  <view class="hero-glow hero-glow-b"></view>

  <view class="logo-area">
    <view class="logo-icon">
      <text class="logo-icon-inner">⚡</text>
    </view>
    <text class="logo-text">PowerNest</text>
    <text class="logo-sub">注册账号</text>
  </view>

  <view class="card register-card">
    <text class="title">欢迎加入</text>
    <text class="subtitle">创建账号，开启明亮高效的换电体验</text>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder-class="input-placeholder" placeholder="请输入11位手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input" type="text" placeholder-class="input-placeholder" placeholder="请输入用户名 (3-20位)" value="{{username}}" bindinput="onUsernameInput" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" password="{{true}}" placeholder-class="input-placeholder" placeholder="至少8位，含字母和数字" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" password="{{true}}" placeholder-class="input-placeholder" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>

    <button class="btn" type="primary" loading="{{loading}}" bindtap="onRegisterTap">注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="login-text" bindtap="goToLogin">立即登录</text>
    </view>
  </view>
</view>
