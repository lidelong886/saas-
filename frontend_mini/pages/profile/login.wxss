page {
  background: #F0FDFA;
}

.container {
  min-height: 100vh;
  padding: 96rpx 32rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: var(--brand-soft-gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
  pointer-events: none;
}

.hero-glow-a {
  width: 420rpx;
  height: 420rpx;
  right: -150rpx;
  top: -120rpx;
  background: rgba(45, 212, 191, 0.55);
}

.hero-glow-b {
  width: 360rpx;
  height: 360rpx;
  left: -140rpx;
  bottom: 120rpx;
  background: rgba(255, 107, 107, 0.28);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  margin-bottom: 56rpx;
}

.logo-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: var(--brand-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(20, 184, 166, 0.28);
  margin-bottom: 20rpx;
}

.logo-icon-inner {
  font-size: 58rpx;
  line-height: 1;
}

.logo-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 1rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.login-card {
  width: 100%;
  margin: 0;
  padding: 52rpx 40rpx 44rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 24rpx 70rpx rgba(20, 184, 166, 0.16);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  z-index: 1;
  position: relative;
}

.login-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 44rpx;
  right: 44rpx;
  height: 6rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: var(--brand-gradient);
}

.title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 44rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #0F766E;
  margin-bottom: 14rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  border: 2rpx solid rgba(20, 184, 166, 0.18);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #111827;
  background: rgba(240, 253, 250, 0.78);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--primary);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(20, 184, 166, 0.10);
}

.input-placeholder {
  color: #94A3B8;
}

.btn {
  margin-top: 22rpx;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  font-weight: 800;
  font-size: 32rpx;
  letter-spacing: 3rpx;
  background: var(--brand-gradient) !important;
  border: none !important;
  color: #ffffff !important;
  box-shadow: 0 16rpx 34rpx rgba(20, 184, 166, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 18rpx rgba(20, 184, 166, 0.2);
}

.register-link {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748B;
}

.register-text {
  color: var(--cta);
  font-weight: 800;
  margin-left: 10rpx;
}


