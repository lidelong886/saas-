<view class="container">
  <view class="card">
    <text class="label">账户余额（元）</text>
    <text class="amount">{{balanceText}}</text>
    <text class="sub" wx:if="{{points > 0}}">积分 {{points}}</text>
  </view>

  <!-- 本周收支摘要 -->
  <view class="cost-summary">
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-label">本周支出</text>
        <text class="summary-value expense">¥{{weekExpense || '0.00'}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">本周充值</text>
        <text class="summary-value income">¥{{weekIncome || '0.00'}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">快捷充值</text>
    <view class="chips">
      <view class="chip {{amountPick === 50 ? 'on' : ''}}" bindtap="pickAmount" data-v="50">50</view>
      <view class="chip {{amountPick === 100 ? 'on' : ''}}" bindtap="pickAmount" data-v="100">100</view>
      <view class="chip {{amountPick === 200 ? 'on' : ''}}" bindtap="pickAmount" data-v="200">200</view>
    </view>
    <input class="input" type="digit" placeholder="或输入自定义金额" value="{{customAmount}}" bindinput="onCustomInput" />
    <button class="btn" type="primary" loading="{{loading}}" bindtap="onRecharge">确认充值（演示直接到账）</button>
  </view>

  <view class="section">
    <text class="section-title">最近钱包流水</text>
    <view wx:if="{{records.length === 0}}" class="empty">暂无记录</view>
    <view class="row" wx:for="{{records}}" wx:key="id">
      <view class="row-main">
        <text class="row-title">{{item.displayTitle}}</text>
        <text class="row-sub">{{item.displayTime}}</text>
        <text class="row-sub" wx:if="{{item.displayRemark}}">{{item.displayRemark}}</text>
      </view>
      <text class="row-amt {{item.direction === 'expense' ? 'amt-expense' : 'amt-income'}}">{{item.displayAmount}}</text>
    </view>
  </view>
</view>
