/* pages/profile/change-password.wxss */
.container {
  background: #F8FAFC;
  min-height: 100vh;
  padding: 40rpx var(--space-16);
}

.form {
  background: white;
  border-radius: var(--radius-md);
  padding: 8rpx 0;
  margin-bottom: var(--space-16);
}

.form-item {
  display: flex;
  flex-direction: column;
  padding: var(--space-16) var(--space-16);
  border-bottom: 1rpx solid #f3f4f6;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: var(--text-base);
  color: #6b7280;
  margin-bottom: 16rpx;
}

.input {
  font-size: var(--space-16);
  color: #1f2937;
  padding: 16rpx 0;
}

.tips {
  background: #fef3c7;
  border-radius: var(--radius-sm);
  padding: var(--radius-md) var(--space-16);
  margin-bottom: 40rpx;
}

.tip-item {
  display: block;
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.8;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  padding: 28rpx;
  font-size: var(--space-16);
  font-weight: 600;
}


