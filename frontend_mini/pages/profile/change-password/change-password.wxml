<!--pages/profile/change-password.wxml-->
<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="label">原密码</text>
      <input class="input" type="password" placeholder="请输入原密码" bindinput="onOldPasswordInput" />
    </view>
    <view class="form-item">
      <text class="label">新密码</text>
      <input class="input" type="password" placeholder="请输入新密码（至少8位，含字母和数字）" bindinput="onNewPasswordInput" />
    </view>
    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请再次输入新密码" bindinput="onConfirmPasswordInput" />
    </view>
  </view>

  <view class="tips">
    <text class="tip-item">• 密码至少8位，且包含字母和数字</text>
    <text class="tip-item">• 新密码不能与原密码相同</text>
    <text class="tip-item">• 修改成功后需重新登录</text>
  </view>

  <button class="submit-btn" bindtap="onSubmit">确认修改</button>
</view>
