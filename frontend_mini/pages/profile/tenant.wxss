/* pages/profile/tenant.wxss */
.container {
  min-height: 100vh;
  background: #F0FDFA;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary) 100%);
  padding: 60rpx 40rpx var(--btn-height);
  color: white;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.form-container {
  margin: -40rpx 30rpx 0;
}

.section {
  background: white;
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: var(--space-16);
  font-weight: 500;
  color: #333;
  margin-bottom: var(--radius-md);
  position: relative;
  padding-left: var(--radius-md);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: var(--primary);
  border-radius: var(--radius-sm);
}

.input-group {
  display: flex;
  align-items: center;
  padding: var(--radius-md) 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-group:last-child {
  border-bottom: none;
}

.input-group.vertical {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 212rpx;
  font-size: var(--text-base);
  color: #666;
}

.input {
  flex: 1;
  font-size: var(--text-base);
  color: #333;
  text-align: right;
}

.picker-view {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: var(--text-base);
  color: #333;
}

.placeholder {
  color: #999;
}

.arrow {
  color: #c0c0c0;
  margin-left: 10rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #F8FAFC;
  border-radius: var(--radius-sm);
  padding: var(--radius-md);
  font-size: var(--text-base);
  color: #333;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.submit-btn {
  background: var(--primary);
  color: white;
  border-radius: 50rpx;
  font-size: var(--space-16);
  margin-top: 60rpx;
  box-shadow: 0 8rpx var(--radius-md) rgba(20, 184, 166, 0.3);
}

.submit-btn[disabled] {
  background: #a5a5a5 !important;
  color: #fff !important;
  box-shadow: none !important;
}

.success-container {
  margin: 60rpx 40rpx;
  background: white;
  border-radius: var(--radius-md);
  padding: var(--btn-height) 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx var(--radius-md) var(--shadow-sm);
}

.success-icon {
  width: 112rpx;
  height: 112rpx;
  background: #10b981;
  color: white;
  border-radius: 50%;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: var(--radius-md);
}

.success-desc {
  font-size: var(--text-base);
  color: #666;
  line-height: 1.6;
  margin-bottom: 60rpx;
}

.back-btn {
  background: #F0FDFA;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 0 60rpx;
}


