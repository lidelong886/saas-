page {
  background: #F0FDFA;
}

.container {
  min-height: 100vh;
  padding: 72rpx 32rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: var(--brand-soft-gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
  pointer-events: none;
}

.hero-glow-a {
  width: 420rpx;
  height: 420rpx;
  right: -150rpx;
  top: -140rpx;
  background: rgba(45, 212, 191, 0.55);
}

.hero-glow-b {
  width: 360rpx;
  height: 360rpx;
  left: -140rpx;
  bottom: 120rpx;
  background: rgba(255, 107, 107, 0.28);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  margin-bottom: 42rpx;
}

.logo-icon {
  width: 118rpx;
  height: 118rpx;
  background: var(--brand-gradient);
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  box-shadow: 0 18rpx 44rpx rgba(20, 184, 166, 0.26);
}

.logo-icon-inner {
  font-size: 56rpx;
  color: #fff;
}

.logo-text {
  font-size: 46rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 8rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #64748B;
  letter-spacing: 4rpx;
}

.register-card {
  width: 100%;
  margin: 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 48rpx 40rpx 44rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 70rpx rgba(20, 184, 166, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  position: relative;
  z-index: 1;
}

.register-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 44rpx;
  right: 44rpx;
  height: 6rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: var(--brand-gradient);
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 38rpx;
}

.form-item {
  margin-bottom: 26rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #0F766E;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  height: 92rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  border: 2rpx solid rgba(20, 184, 166, 0.18);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #111827;
  background: rgba(240, 253, 250, 0.78);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--primary);
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(20, 184, 166, 0.10);
}

.input-placeholder {
  color: #94A3B8;
}

.btn {
  background: var(--brand-gradient) !important;
  color: #fff !important;
  border-radius: 28rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  margin-top: 34rpx;
  box-shadow: 0 16rpx 34rpx rgba(20, 184, 166, 0.24);
}

.login-link {
  margin-top: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748B;
}

.login-text {
  color: var(--cta);
  font-weight: 800;
  margin-left: 10rpx;
}


