/* pages/fault/report.wxss */
.container {
  padding: var(--radius-md) 30rpx 160rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--radius-md);
  margin-bottom: var(--radius-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: var(--radius-md);
}

.required {
  color: #ff4d4f;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 14rpx 28rpx;
  background: #f0f0f0;
  border-radius: var(--radius-sm);
  font-size: var(--text-base);
  color: #666;
  border: 2rpx solid transparent;
}

.type-item.active {
  background: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
}

.desc-input {
  width: 100%;
  height: 200rpx;
  background: #f8f8f8;
  border-radius: var(--radius-sm);
  padding: 16rpx;
  font-size: var(--text-base);
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: var(--radius-md);
  color: #999;
  margin-top: 8rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: var(--radius-md);
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  background: #f8f8f8;
  border: 2rpx dashed #d9d9d9;
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
}

.add-text {
  font-size: var(--radius-md);
  color: #999;
}

.station-tag {
  display: inline-block;
  padding: 8rpx var(--radius-md);
  background: #f0f0f0;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: #666;
}

.phone-input {
  height: var(--btn-height);
  background: #f8f8f8;
  border-radius: var(--radius-sm);
  padding: 0 16rpx;
  font-size: var(--text-base);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--radius-md) 30rpx;
  padding-bottom: calc(var(--radius-md) + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx var(--shadow-sm);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #1890ff;
  color: #fff;
  font-size: var(--space-16);
  border-radius: 44rpx;
  border: none;
  line-height: 88rpx;
}

.submit-btn[disabled] {
  background: #b0d4f1;
}


