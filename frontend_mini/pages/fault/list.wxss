/* pages/fault/list.wxss */
.container {
  padding: var(--radius-md) 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.report-item {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--radius-md);
  margin-bottom: var(--radius-md);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.report-no {
  font-size: 26rpx;
  color: #999;
  font-family: monospace;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: var(--radius-md);
}

.report-body {
  margin-bottom: 16rpx;
}

.report-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.report-desc {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.report-station {
  font-size: var(--radius-md);
  color: #999;
}

.report-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: var(--radius-sm);
}

.report-time {
  font-size: var(--radius-md);
  color: #999;
}

.empty-state {
  text-align: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: var(--text-base);
  color: #999;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx var(--radius-md) rgba(24, 144, 255, 0.4);
}

.fab-btn text {
  color: #fff;
  font-size: 48rpx;
  line-height: 1;
}


