<view class="container">
  <view wx:if="{{order}}">
    <view class="card">
      <view class="row">
        <text class="label">订单号</text>
        <text class="value">{{order.order_no}}</text>
      </view>
      <view class="row">
        <text class="label">类型</text>
        <text class="value">{{typeText}}</text>
      </view>
      <view class="row">
        <text class="label">状态</text>
        <text class="value">{{statusText}}</text>
      </view>
      <view class="row">
        <text class="label">电池</text>
        <text class="value" wx:if="{{order.battery_id || order.battery_code}}">{{order.battery_code || order.battery_id}}</text>
        <text class="value" wx:elif="{{order.package_name}}">{{order.package_name}}</text>
        <text class="value" wx:else>-</text>
      </view>
      <view class="row">
        <text class="label">金额</text>
        <text class="value">¥{{order.total_amount}}</text>
      </view>
      <view class="row">
        <text class="label">创建时间</text>
        <text class="value">{{order.created_at}}</text>
      </view>
      <view class="row">
        <text class="label">支付时间</text>
        <text class="value">{{order.payment_time || '-'}}</text>
      </view>
    </view>

    <view class="actions">
      <button wx:if="{{order.status === 'pending'}}" type="primary" bindtap="goToPay">去支付</button>
      <button wx:if="{{order.status === 'pending'}}" type="default" loading="{{cancelling}}" bindtap="onCancel">取消订单</button>
      <button wx:if="{{order.order_type === 'rental' && order.status === 'rented' && order.battery_id}}" type="primary" loading="{{returning}}" bindtap="onReturnBattery">归还电池</button>
      <button wx:if="{{order.order_type !== 'rental' && (order.status === 'paid' || order.status === 'returned' || order.status === 'completed')}}" type="warn" loading="{{refunding}}" bindtap="onRefund">申请退款</button>
      <text class="refund-tip" wx:if="{{order.order_type !== 'rental' && (order.status === 'paid' || order.status === 'returned' || order.status === 'completed')}}">退款将按当前订单实付金额发起申请</text>
      <button wx:if="{{order.status !== 'pending'}}" type="default" bindtap="refresh">刷新状态</button>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">未找到订单</text>
  </view>
</view>
