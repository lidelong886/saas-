<!--pages/order/list.wxml-->
<view class="container">
  <!-- 标签栏 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === item.key ? 'active' : ''}}" 
          wx:for="{{tabs}}" wx:key="key"
          bindtap="onTabChange" data-tab="{{item.key}}">
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
    <view class="order-card" wx:for="{{filteredOrders}}" wx:key="order_no" 
          bindtap="onOrderTap" data-order-no="{{item.order_no}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-number">订单号: {{item.order_no}}</text>
        <view class="order-status status-{{item.status}}">
          {{item.status_text}}
        </view>
      </view>

      <!-- 订单内容 -->
      <view class="order-content">
        <view class="order-info">
          <text class="order-type">{{item.type_text}}</text>
          <text class="order-battery" wx:if="{{item.battery_id || item.battery_code}}">电池编号: {{item.battery_code || item.battery_id}}</text>
          <text class="order-battery" wx:elif="{{item.package_name}}">套餐名称: {{item.package_name}}</text>
          <text class="order-battery" wx:else>关联对象: -</text>
          <text class="order-station">站点: {{item.station_name || item.station_id || '-'}}</text>
        </view>
        <view class="order-price">
          <text class="price-label">金额</text>
          <text class="price-value">¥{{item.total_amount}}</text>
        </view>
      </view>

      <!-- 订单时间 -->
      <view class="order-time">
        <text class="time-label">创建时间:</text>
        <text class="time-value">{{item.created_at}}</text>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions" wx:if="{{item.status === 'pending' || item.status === 'paid'}}">
        <button class="action-btn cancel-btn" wx:if="{{item.status === 'pending'}}"
                bindtap="onCancelOrder" data-order-no="{{item.order_no}}">取消订单</button>
        <button class="action-btn pay-btn" wx:if="{{item.status === 'pending'}}"
                bindtap="onPayOrder" data-order-no="{{item.order_no}}">立即支付</button>
        <button class="action-btn review-btn" wx:if="{{item.status === 'completed'}}"
                bindtap="onReviewOrder" data-order-no="{{item.order_no}}">评价</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <button class="empty-btn" bindtap="goToIndex">去首页看看</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isLoading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && filteredOrders.length > 0}}">
    <text class="no-more-text">没有更多了</text>
  </view>
</view>
