<!-- pages/notification/list.wxml -->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="top-bar" wx:if="{{notifications.length > 0}}">
    <text class="unread-info" wx:if="{{unreadCount > 0}}">{{unreadCount}}条未读</text>
    <text class="unread-info" wx:else>全部已读</text>
    <view class="mark-all-btn" bindtap="onMarkAllRead" wx:if="{{unreadCount > 0}}">
      <text>全部已读</text>
    </view>
  </view>

  <!-- 通知列表 -->
  <view class="noti-list" wx:if="{{notifications.length > 0}}">
    <view
      class="noti-item {{item.is_read ? '' : 'unread'}}"
      wx:for="{{notifications}}"
      wx:key="id"
      data-item="{{item}}"
      bindtap="onNotificationTap"
    >
      <view class="noti-icon-wrap">
        <view class="noti-icon noti-icon-{{item.noti_type}}">
          <text wx:if="{{item.noti_type === 'order'}}">O</text>
          <text wx:elif="{{item.noti_type === 'exchange'}}">E</text>
          <text wx:elif="{{item.noti_type === 'system'}}">S</text>
          <text wx:elif="{{item.noti_type === 'fault'}}">F</text>
          <text wx:else>N</text>
        </view>
        <view class="unread-dot" wx:if="{{!item.is_read}}"></view>
      </view>

      <view class="noti-content">
        <view class="noti-title-row">
          <text class="noti-type-label">{{typeLabels[item.noti_type] || '通知'}}</text>
          <text class="noti-time">{{item.created_at}}</text>
        </view>
        <text class="noti-title">{{item.title}}</text>
        <text class="noti-body">{{item.content}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{notifications.length === 0 && !isLoading}}">
    <text class="empty-text">暂无消息通知</text>
  </view>

  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>
</view>
