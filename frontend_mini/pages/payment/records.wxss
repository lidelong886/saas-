.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: var(--radius-md);
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: var(--radius-md);
}

.record-item {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--radius-md);
  box-shadow: 0 2rpx 8rpx var(--shadow-sm);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-icon {
  font-size: var(--space-16);
}

.type-text {
  font-size: var(--text-base);
  font-weight: 600;
  color: #333;
}

.record-status {
  font-size: var(--radius-md);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 600;
}

.status-paid {
  background: #f0fdf4;
  color: #16a34a;
}

.status-pending {
  background: #fef3c7;
  color: #d97706;
}

.status-failed {
  background: #fee2e2;
  color: #dc2626;
}

.status-refunded {
  background: #f3f4f6;
  color: #6b7280;
}

.record-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-no {
  font-size: var(--radius-md);
  color: #666;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 112rpx 0;
}

.empty-icon {
  font-size: 112rpx;
  margin-bottom: var(--radius-md);
  opacity: 0.3;
}

.empty-text {
  font-size: var(--text-base);
  color: #999;
}

.loading-more,
.no-more {
  text-align: center;
  padding: var(--space-16) 0;
}

.loading-text,
.no-more-text {
  font-size: var(--radius-md);
  color: #999;
}


