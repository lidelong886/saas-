<view class="container">
  <view class="records-list" wx:if="{{records.length > 0}}">
    <view
      class="record-item"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="onRecordTap"
      data-item="{{item}}"
    >
      <view class="record-header">
        <view class="record-type">
          <text class="type-icon">{{item.payment_type === 'recharge' ? '💰' : '🛍'}}</text>
          <text class="type-text">{{item.payment_type === 'recharge' ? '账户充值' : '订单支付'}}</text>
        </view>
        <view class="record-status status-{{item.status}}">
          {{item.status === 'paid' ? '已支付' : item.status === 'pending' ? '待支付' : item.status === 'failed' ? '失败' : '已退款'}}
        </view>
      </view>

      <view class="record-body">
        <view class="record-info">
          <text class="record-no">单号: {{item.payment_no}}</text>
          <text class="record-time">{{item.created_at}}</text>
        </view>
        <view class="record-amount">¥{{item.amount}}</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{!loading}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无支付记录</text>
  </view>

  <view class="loading-more" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
    <text class="no-more-text">没有更多了</text>
  </view>
</view>
