<!-- 电池预约详情页面 -->
<view class="reservation-detail-page">
  <!-- 状态卡片 -->
  <view class="status-card {{reservation.status}}">
    <view class="status-icon">
      <text wx:if="{{reservation.status === 'active'}}">⏱</text>
      <text wx:if="{{reservation.status === 'completed'}}">✓</text>
      <text wx:if="{{reservation.status === 'cancelled'}}">✕</text>
      <text wx:if="{{reservation.status === 'expired'}}">⚠</text>
    </view>
    <view class="status-text">
      <text wx:if="{{reservation.status === 'active'}}">预约进行中</text>
      <text wx:if="{{reservation.status === 'completed'}}">已完成</text>
      <text wx:if="{{reservation.status === 'cancelled'}}">已取消</text>
      <text wx:if="{{reservation.status === 'expired'}}">已过期</text>
    </view>

    <!-- 倒计时（仅活跃状态显示） -->
    <countdown
      wx:if="{{reservation.status === 'active'}}"
      endTime="{{reservation.expires_at}}"
      totalDuration="{{reservation.duration * 60 * 1000}}"
      label="剩余时间"
      showProgress="{{true}}"
      className="{{countdownClass}}"
      bindtimeout="onTimeout"
      bindwarning="onWarning"
    ></countdown>
  </view>

  <!-- 站点信息 -->
  <view class="info-section">
    <view class="section-title">换电站信息</view>
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">站点名称</text>
        <text class="info-value">{{reservation.station.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">站点地址</text>
        <text class="info-value">{{reservation.station.address}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">距离</text>
        <text class="info-value highlight">{{reservation.station.distance}}km</text>
      </view>
      <button class="navigate-btn" bindtap="navigateToStation">
        <text class="btn-icon">📍</text>
        <text>导航前往</text>
      </button>
    </view>
  </view>

  <!-- 电池信息 -->
  <view class="info-section">
    <view class="section-title">预约电池</view>
    <view class="info-card battery-card">
      <view class="battery-header">
        <text class="battery-code">#{{reservation.battery.code}}</text>
        <battery-status available="1" total="1"></battery-status>
      </view>
      <view class="battery-stats">
        <view class="stat-item">
          <text class="stat-label">电量</text>
          <text class="stat-value">{{reservation.battery.charge}}%</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">健康度</text>
          <text class="stat-value">{{reservation.battery.health}}%</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">预计续航</text>
          <text class="stat-value">{{reservation.battery.estimated_range}}km</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 预约信息 -->
  <view class="info-section">
    <view class="section-title">预约信息</view>
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{reservation.reserved_at_formatted}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">保留时长</text>
        <text class="info-value">{{reservation.duration}}分钟</text>
      </view>
      <view class="info-row">
        <text class="info-label">到期时间</text>
        <text class="info-value highlight">{{reservation.expires_at_formatted}}</text>
      </view>
      <view wx:if="{{reservation.completed_at}}" class="info-row">
        <text class="info-label">完成时间</text>
        <text class="info-value">{{reservation.completed_at_formatted}}</text>
      </view>
    </view>
  </view>

  <!-- 温馨提示 -->
  <view class="tips-section">
    <view class="tips-title">温馨提示</view>
    <view class="tips-item">• 请在预约时间内到达换电站</view>
    <view class="tips-item">• 到站后请在5分钟内完成换电</view>
    <view class="tips-item">• 如无法按时到达，请提前取消预约</view>
    <view class="tips-item">• 超时未取消将影响您的信用分</view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions" wx:if="{{reservation.status === 'active'}}">
    <button class="action-btn cancel-btn" bindtap="cancelReservation">
      取消预约
    </button>
    <button class="action-btn complete-btn" bindtap="completeReservation">
      已到站，开始换电
    </button>
  </view>
</view>
