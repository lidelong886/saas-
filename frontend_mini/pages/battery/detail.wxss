.container { padding: var(--radius-md); min-height: 100vh; background: #F0FDFA; box-sizing: border-box; }
.card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--space-16);
  margin-bottom: var(--space-16);
}
.title { font-size: 36rpx; font-weight: 600; display: block; margin-bottom: var(--radius-md); }
.line { font-size: var(--text-base); color: #444; display: block; margin-bottom: var(--radius-sm); }
.tip { font-size: 26rpx; color: #999; display: block; margin-top: var(--radius-md); }
.empty { text-align: center; color: #999; padding: var(--btn-height) 0; }


