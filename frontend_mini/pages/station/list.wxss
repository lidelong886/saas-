/* pages/station/list.wxss — PowerNest 站点列表页 */

/* ── 背景 ──────────────────────────────────────────── */
.container {
  min-height: 100vh;
  background: #f0f2f8;
  padding-bottom: var(--radius-md);
}

/* ── 搜索栏 ───────────────────────────────────────── */
.search-bar {
  background: #ffffff;
  padding: var(--radius-md) var(--radius-md);
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--gray-100);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  flex: 1;
  background: #f8fafc;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-md);
  padding: 16rpx var(--radius-md);
  display: flex;
  align-items: center;
  position: relative;
  transition: all var(--duration);
}

.search-box:focus-within {
  border-color: var(--primary);
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(20, 184, 166, 0.1);
}

.search-input {
  flex: 1;
  font-size: var(--text-base);
  margin-left: var(--radius-sm);
  color: #1f2937;
}

.clear-btn {
  margin-left: 8rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--gray-700);
  font-size: 28rpx;
  font-weight: 700;
  min-height: 68rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid var(--gray-200);
  border-radius: 999rpx;
  flex-shrink: 0;
  transition: all var(--duration);
}

.filter-btn:active {
  background: var(--gray-100);
}

/* ── 筛选面板 ─────────────────────────────────────── */
.filter-panel {
  background: #ffffff;
  border-bottom: 1rpx solid var(--gray-100);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.filter-panel.show {
  max-height: 400rpx;
}

.filter-section {
  padding: var(--radius-md);
  border-bottom: 1rpx solid var(--gray-100);
}

.filter-section:last-child {
  border-bottom: none;
}

.filter-title {
  display: block;
  font-size: 22rpx;
  color: var(--gray-500);
  margin-bottom: 16rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.filter-options {
  display: flex;
  gap: var(--radius-sm);
  flex-wrap: wrap;
}

.filter-option {
  padding: 10rpx var(--radius-md);
  border: 2rpx solid var(--gray-200);
  border-radius: 50rpx;
  font-size: var(--radius-md);
  color: var(--gray-600);
  background: #ffffff;
  transition: all var(--duration);
  font-weight: 500;
}

.filter-option.active {
  background: linear-gradient(135deg, var(--primary), var(--primary));
  color: #ffffff;
  border-color: var(--primary);
  box-shadow: 0 4rpx var(--radius-sm) rgba(20, 184, 166, 0.25);
}

/* ── 站点列表 ─────────────────────────────────────── */
.station-list {
  padding: var(--radius-md) var(--radius-md);
}

.station-item {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx var(--radius-md) rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  transition: all var(--duration);
}

.station-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.station-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* ── 站点头部 ─────────────────────────────────────── */
.station-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.station-info {
  flex: 1;
  min-width: 0;
}

.station-name {
  display: block;
  font-size: var(--space-16);
  font-weight: 700;
  color: var(--gray-900);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-distance {
  display: block;
  font-size: 22rpx;
  color: var(--gray-400);
  font-weight: 500;
}

/* ── 状态标签 ─────────────────────────────────────── */
.station-status {
  padding: 8rpx 16rpx;
  border-radius: 50rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: var(--radius-sm);
}

.station-status.active {
  background: #d1fae5;
  color: #059669;
}

.station-status.maintenance {
  background: #fef3c7;
  color: #d97706;
}

.station-status.inactive {
  background: #fee2e2;
  color: #dc2626;
}

/* ── 地址 ─────────────────────────────────────────── */
.station-address {
  display: block;
  font-size: var(--radius-md);
  color: var(--gray-500);
  margin-bottom: var(--radius-md);
  line-height: 1.5;
  padding-left: 4rpx;
}

/* ── 统计数据 ─────────────────────────────────────── */
.station-stats {
  display: flex;
  justify-content: space-around;
  background: #f8fafc;
  border-radius: var(--radius-md);
  padding: var(--radius-md) 16rpx;
  margin-bottom: var(--radius-md);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--gray-400);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary);
}

/* ── 操作按钮 ─────────────────────────────────────── */
.station-actions {
  display: flex;
  gap: var(--radius-sm);
}

.action-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.action-btn.navigate {
  background: #ffffff;
  color: var(--primary);
  border: 2rpx solid var(--gray-200);
}

.action-btn.detail {
  background: var(--brand-gradient);
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(20, 184, 166, 0.24);
}

/* ── 空状态 ───────────────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 112rpx 40rpx;
  text-align: center;
}

.empty-text {
  color: var(--gray-400);
  font-size: var(--text-base);
  margin: var(--radius-md) 0;
  font-weight: 500;
}

.refresh-btn {
  background: var(--brand-gradient);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  min-height: 84rpx;
  padding: 0 56rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(20, 184, 166, 0.24);
}

/* ── 加载更多 ─────────────────────────────────────── */
.load-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-16);
  gap: var(--radius-sm);
}

.loading-spinner {
  width: var(--space-16);
  height: var(--space-16);
  border: 3rpx solid var(--gray-200);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text,
.no-more-text {
  color: var(--gray-400);
  font-size: 26rpx;
}

/* ── 站点健康状态标签 ────────────────────────────────── */
.station-header-right {
  display: flex;
  align-items: center;
  gap: var(--radius-sm);
}

.station-health-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 600;
}
.health-good { background: #dcfce7; color: #166534; }
.health-low { background: #fef3c7; color: #92400e; }
.health-empty { background: #f3f4f6; color: #6b7280; }
.health-maintenance { background: #fee2e2; color: #991b1b; }

.station-battery-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 60rpx;
}

.count-number {
  font-size: var(--space-16);
  font-weight: 800;
  color: var(--primary);
  line-height: 1.1;
}

.count-label {
  font-size: 18rpx;
  color: var(--gray-400);
}

/* ── 更新时间提示 ─────────────────────────────────── */
.update-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--radius-sm) var(--radius-md);
  background: #eef2ff;
  font-size: 22rpx;
}

.update-time {
  color: var(--primary);
  font-weight: 600;
}

.update-hint {
  color: var(--gray-400);
}


