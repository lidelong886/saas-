/* pages/index/index.wxss — 明亮薄荷风首页 */

.container {
  min-height: 100vh;
  background: var(--brand-soft-gradient);
  padding: 24rpx;
  padding-bottom: 208rpx;
  box-sizing: border-box;
}

.delivery-layout,
.normal-layout {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.service-bar {
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(20, 184, 166, 0.12);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(20, 184, 166, 0.12);
}

.service-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.service-label {
  font-size: 22rpx;
  color: var(--gray-500);
  font-weight: 700;
}

.service-name {
  font-size: 31rpx;
  color: var(--gray-900);
  font-weight: 900;
  line-height: 1.25;
}

.service-action {
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.1);
  color: var(--primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.top-header,
.top-header-empty {
  margin-bottom: 0;
}

.battery-status,
.recommend-station-card,
.status-item,
.station-card,
.delivery-station-card,
.package-card {
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(20, 184, 166, 0.1);
  box-shadow: 0 14rpx 36rpx rgba(20, 184, 166, 0.12);
  position: relative;
  overflow: hidden;
}

.battery-status::after,
.recommend-station-card::after,
.station-card::after,
.delivery-station-card::after,
.package-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--brand-gradient);
}

.battery-status,
.recommend-station-card {
  border-radius: 28rpx;
  padding: 32rpx;
}

.battery-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 200ms ease;
}

.battery-status::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary);
}

.battery-status.insight-warning::before {
  background: var(--warning);
}

.battery-status.insight-emergency::before {
  background: var(--danger);
}

.battery-status:active,
.recommend-station-card:active,
.station-card:active,
.delivery-station-card:active,
.package-card:active {
  transform: translateY(-2rpx) scale(0.99);
  box-shadow: 0 18rpx 44rpx rgba(20, 184, 166, 0.16);
}

.status-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

.battery-icon {
  width: 88rpx;
  height: 88rpx;
  background: var(--brand-gradient);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(20, 184, 166, 0.22);
  flex-shrink: 0;
}

.status-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.power-text {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--gray-900);
  line-height: 1.1;
}

.range-text {
  font-size: 26rpx;
  color: var(--gray-500);
}

.status-action,
.section-more {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 184, 166, 0.1);
  color: var(--primary-dark);
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.alert-banner {
  background: #fff7ed;
  border: 2rpx solid rgba(245, 158, 11, 0.24);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.12);
  animation: pulse 2s ease-in-out infinite;
}

.alert-banner.alert-emergency {
  background: var(--danger-bg);
  border-color: rgba(239, 68, 68, 0.24);
}

.alert-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.alert-icon {
  font-size: 34rpx;
}

.alert-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--gray-800);
  font-weight: 700;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.86; }
}

.recommend-station-card {
  transition: all 200ms ease;
}

.recommend-station-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.recommend-station-label {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  background: rgba(20, 184, 166, 0.12);
  color: var(--primary-dark);
  font-size: 22rpx;
  font-weight: 800;
  padding: 0 18rpx;
  border-radius: 999rpx;
  margin-bottom: 14rpx;
}

.recommend-station-name {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--gray-900);
  margin-bottom: 10rpx;
  line-height: 1.2;
}

.recommend-station-address {
  display: block;
  font-size: 25rpx;
  color: var(--gray-500);
  line-height: 1.5;
}

.recommend-top-right {
  flex-shrink: 0;
}

.station-battery-badge {
  min-width: 112rpx;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
  border: 2rpx solid rgba(20, 184, 166, 0.18);
  border-radius: 22rpx;
  padding: 18rpx 22rpx;
  text-align: center;
}

.badge-number {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary);
  line-height: 1;
  margin-bottom: 8rpx;
}

.badge-label {
  font-size: 22rpx;
  color: var(--gray-500);
  font-weight: 700;
}

.recommend-station-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.recommend-meta-item {
  background: var(--gray-50);
  border: 2rpx solid rgba(20, 184, 166, 0.12);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: var(--gray-600);
  font-weight: 600;
}

.nav-button {
  min-height: 96rpx;
  background: var(--brand-gradient);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 14rpx 32rpx rgba(20, 184, 166, 0.26);
  transition: all 200ms ease;
}

.nav-button:active {
  transform: translateY(-3rpx);
  box-shadow: 0 18rpx 40rpx rgba(20, 184, 166, 0.32);
}

.nav-icon {
  font-size: 32rpx;
}

.nav-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.delivery-status {
  display: flex;
  gap: 16rpx;
}

.status-item {
  flex: 1;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-label {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 600;
}

.status-value {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--gray-900);
  line-height: 1.2;
}

.delivery-battery-card {
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(20, 184, 166, 0.12);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 184, 166, 0.14);
  position: relative;
  overflow: hidden;
}

.delivery-battery-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary);
}

.delivery-battery-card.insight-warning::before {
  background: var(--warning);
}

.delivery-battery-card.insight-emergency::before {
  background: var(--danger);
}

.delivery-battery-card.no-battery::before {
  background: var(--gray-300);
}

.delivery-battery-main,
.delivery-battery-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.delivery-battery-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.delivery-battery-label {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 700;
}

.delivery-battery-power {
  font-size: 56rpx;
  line-height: 1;
  color: var(--gray-900);
  font-weight: 900;
}

.delivery-battery-power.small {
  font-size: 34rpx;
  line-height: 1.2;
}

.delivery-battery-tip,
.delivery-battery-footer {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 600;
}

.delivery-battery-badge {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.delivery-power-track {
  height: 16rpx;
  background: var(--gray-100);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 24rpx 0 18rpx;
}

.delivery-power-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brand-gradient);
}

.insight-warning .delivery-power-fill,
.insight-warning .delivery-battery-badge {
  background: linear-gradient(135deg, var(--warning), #f59e0b);
}

.insight-emergency .delivery-power-fill,
.insight-emergency .delivery-battery-badge {
  background: linear-gradient(135deg, var(--danger), var(--cta-dark));
}

.delivery-battery-action {
  color: var(--primary-dark);
  font-weight: 800;
  flex-shrink: 0;
}

.delivery-stations,
.section {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title,
.section-title-delivery {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--gray-900);
}

.section-title-delivery {
  display: block;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.station-list,
.delivery-station-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.station-card,
.delivery-station-card {
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  transition: all 200ms ease;
}

.station-info,
.station-main {
  flex: 1;
  min-width: 0;
}

.station-name,
.station-name-delivery {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--gray-900);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.station-meta,
.station-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
}

.station-distance,
.station-batteries,
.info-block {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 600;
}

.station-batteries,
.info-number.highlight {
  color: var(--primary-dark);
  font-weight: 800;
}

.info-block {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  background: var(--gray-50);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.info-number {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--gray-900);
}

.info-unit {
  font-size: 22rpx;
  color: var(--gray-500);
}

.station-nav,
.station-nav-btn {
  min-width: 120rpx;
  min-height: 72rpx;
  background: rgba(20, 184, 166, 0.12);
  border: 2rpx solid rgba(20, 184, 166, 0.24);
  border-radius: 18rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms ease;
  flex-shrink: 0;
}

.station-nav:active,
.station-nav-btn:active {
  background: rgba(20, 184, 166, 0.18);
  transform: scale(0.96);
}

.nav-icon-small,
.station-nav-btn .nav-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary-dark);
}

.package-list {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.package-card {
  min-width: 296rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  transition: all 200ms ease;
  box-sizing: border-box;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.package-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--gray-900);
}

.package-price {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--cta-dark);
}

.package-desc {
  font-size: 24rpx;
  color: var(--gray-500);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.package-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.package-duration,
.package-times {
  background: var(--gray-50);
  border: 2rpx solid rgba(20, 184, 166, 0.1);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--gray-500);
  font-weight: 600;
}

.scan-button-giant,
.scan-button-delivery {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  min-height: 124rpx;
  background: var(--brand-gradient);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 20rpx 52rpx rgba(20, 184, 166, 0.32);
  z-index: 100;
  transition: all 200ms ease;
}

.scan-button-giant::before,
.scan-button-delivery::before {
  content: '';
  position: absolute;
  inset: 3rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 28rpx;
}

.scan-button-giant:active,
.scan-button-delivery:active {
  transform: translateY(-4rpx);
  box-shadow: 0 24rpx 60rpx rgba(20, 184, 166, 0.38);
}

.scan-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.scan-icon-giant,
.scan-icon-large {
  font-size: 48rpx;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.scan-button-text,
.scan-text-large {
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.empty-state,
.empty-state-delivery {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  font-weight: 600;
}
