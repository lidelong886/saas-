.container {
  min-height: 100vh;
  background: var(--brand-soft-gradient);
  padding: 16rpx;
  box-sizing: border-box;
}

/* 骑手专属入口卡片 */
.rider-entry-card {
  background: var(--brand-gradient);
  border-radius: var(--radius-md);
  padding: var(--space-16);
  margin-bottom: var(--radius-md);
  box-shadow: 0 14rpx 36rpx rgba(20, 184, 166, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.48);
}

.rider-card-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rider-card-left {
  flex: 1;
}

.rider-card-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.rider-card-subtitle {
  display: block;
  font-size: var(--radius-md);
  color: #64748B;
  margin-bottom: 16rpx;
}

.rider-card-features {
  display: flex;
  gap: 16rpx;
}

.feature-item {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(20, 184, 166, 0.12);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(20, 184, 166, 0.22);
}

.rider-card-right {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--btn-height);
  height: var(--btn-height);
  background: rgba(255, 255, 255, 0.26);
  border-radius: 50%;
}

.rider-card-arrow {
  font-size: 48rpx;
  color: var(--primary);
  font-weight: bold;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.package-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--radius-md);
  box-shadow: 0 6rpx var(--radius-md) rgba(15, 23, 42, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--radius-md);
  margin-bottom: var(--radius-md);
}

.package-name {
  display: block;
  font-size: var(--space-16);
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 8rpx;
}

.package-type {
  display: inline-block;
  font-size: 22rpx;
  color: #0d9488;
  background: #ecfeff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.package-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ef4444;
}

.package-body {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: var(--radius-md);
}

.meta-item {
  background: var(--brand-soft-gradient);
  border-radius: var(--radius-sm);
  padding: 18rpx;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: var(--gray-400);
  margin-bottom: 8rpx;
}

.meta-value {
  display: block;
  font-size: 26rpx;
  color: var(--gray-700);
  word-break: break-all;
}

.package-desc {
  display: block;
  font-size: var(--radius-md);
  color: var(--gray-500);
  line-height: 1.6;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 112rpx;
  margin-bottom: var(--radius-md);
}

.empty-text {
  font-size: var(--text-base);
  color: var(--gray-400);
  margin-bottom: var(--space-16);
}

.empty-btn {
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #fff;
  border-radius: 999rpx;
  padding: 0 48rpx;
  font-size: var(--text-base);
}

.loading,
.no-more {
  text-align: center;
  padding: var(--space-16) 0;
}

.loading-text,
.no-more-text {
  font-size: var(--radius-md);
  color: var(--gray-400);
}

.package-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--radius-md);
  border-top: 1rpx solid var(--shadow-sm);
  padding-top: var(--radius-md);
}
.buy-btn {
  margin: 0;
  min-width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(20, 184, 166, 0.26);
}

/* 推荐模块样式 */
.recommend-section {
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--radius-md) 0;
  margin-bottom: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  padding: 0 var(--radius-md);
  margin-bottom: var(--radius-md);
}

.list-header {
  margin-top: var(--space-16);
  padding-left: 8rpx;
}

.section-title {
  display: block;
  font-size: var(--space-16);
  font-weight: 700;
  color: var(--gray-900);
}

.section-subtitle {
  display: block;
  font-size: var(--radius-md);
  color: var(--gray-500);
  margin-top: 8rpx;
}

.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.recommend-card {
  display: inline-block;
  width: 288rpx;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-md);
  padding: var(--radius-md);
  margin-left: var(--radius-md);
  box-sizing: border-box;
}

.recommend-card:last-child {
  margin-right: var(--radius-md);
}

.rec-header {
  margin-bottom: var(--radius-sm);
}

.rec-name {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--gray-800);
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.rec-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
  margin-bottom: 8rpx;
}

.rec-desc {
  display: block;
  font-size: 22rpx;
  color: var(--gray-500);
  margin-bottom: var(--radius-md);
}

.rec-buy-btn {
  margin: 0;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 800;
  background: var(--brand-gradient);
  color: #fff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 184, 166, 0.22);
}




