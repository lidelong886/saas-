.container {
  min-height: 100vh;
  background: #f8fafc;
  padding: var(--radius-md);
  box-sizing: border-box;
}

.hero-card,
.detail-card,
.tips-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: var(--radius-md);
  box-shadow: 0 8rpx var(--radius-md) rgba(15, 23, 42, 0.06);
}

.hero-card {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
}

.package-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.package-type {
  display: inline-block;
  font-size: 22rpx;
  color: #0f766e;
  background: rgba(255, 255, 255, 0.92);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: var(--radius-md);
}

.package-price {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.package-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.7;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: var(--radius-md);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: var(--gray-400);
}

.value {
  font-size: var(--text-base);
  color: var(--gray-700);
  text-align: right;
}

.active {
  color: var(--success);
}

.inactive {
  color: #ef4444;
}

.tips-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 16rpx;
}

.tips-text {
  display: block;
  font-size: 26rpx;
  color: var(--gray-500);
  line-height: 1.8;
}

.primary-btn {
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.empty {
  text-align: center;
  color: var(--gray-400);
  padding: 112rpx 0;
  font-size: var(--text-base);
}



