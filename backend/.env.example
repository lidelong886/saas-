# Flask 应用配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# 数据库配置
DATABASE_URL=mysql+pymysql://root:your-password@localhost/battery_saas_dev?charset=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 高德地图 API
AMAP_KEY=your-amap-key-here

# 微信支付配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_MCH_ID=your-wechat-mch-id
WECHAT_PRIVATE_KEY=your-wechat-private-key
WECHAT_SERIAL_NO=your-wechat-serial-no

# 订单超时配置
ORDER_PENDING_TIMEOUT_MINUTES=15
ORDER_TIMEOUT_SCAN_INTERVAL_SECONDS=60

# CORS 配置（生产环境请设置具体域名，多个域名用逗号分隔）
CORS_ORIGINS=http://localhost:8080,http://localhost:8084
